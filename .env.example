# ===============================
# Server Configuration
# ===============================
PORT=5000
NODE_ENV=development

# ===============================
# Database Configuration
# ===============================
# MongoDB connection string
# Example:
# mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database_name>

# ===============================
# CORS Configuration
# ===============================
# Comma-separated list of allowed frontend origins
# Example: http://localhost:3000,https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ===============================
# Authentication / Security
# ===============================
# JWT secret key for signing access tokens
JWT_SECRET=your_jwt_secret_here

# Access token expiration (examples: 1d, 7d, 30d)
JWT_EXPIRES_IN=1d

# Separate secret for refresh tokens (must be different from JWT_SECRET)
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
# Ollama (Local LLM) Configuration
# ===============================
# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Ollama model name
# Examples:
# qwen2.5-coder:7b
# gemma:2b
# mistral
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama request timeout in milliseconds
OLLAMA_TIMEOUT_MS=30000

# Maximum number of retry attempts
OLLAMA_MAX_RETRIES=3

# Number of GPUs to use (0 = CPU only)
OLLAMA_NUM_GPU=0

# ===============================
# Code Execution / AI Limits
# ===============================
# Max execution time for code analysis (in milliseconds)
CODE_TIMEOUT_MS=5000

# Rate limiting for submissions (per hour, per IP)
MAX_SUBMISSIONS_PER_HOUR=50
