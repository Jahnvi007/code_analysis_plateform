# ===============================
# Server Configuration
# ===============================
PORT=5000
NODE_ENV=development

# ===============================
# Database Configuration
# ===============================
# MongoDB connection string
# Example:
# mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database_name>

# ===============================
# Authentication / Security
# ===============================
# JWT secret key for signing tokens
JWT_SECRET=your_jwt_secret_here

# Token expiration (examples: 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# ===============================
# Ollama (Local LLM) Configuration
# ===============================
# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Ollama model name
# Examples:
# qwen2.5-coder:7b
# gemma:2b
# mistral
OLLAMA_MODEL=gemma:2b

# ===============================
# Code Execution / AI Limits
# ===============================
# Max execution time for code analysis (in milliseconds)
CODE_TIMEOUT_MS=5000

# Rate limiting for submissions
MAX_SUBMISSIONS_PER_HOUR=50
